          "name": "Search DAM Assets",
          "request": {
            "name": "Search DAM Assets",
            "description": {
              "content": "Retrieve all DAM Assets matching the search criteria. Results should be paginated with per_page items per page. The most relevant results should be provided first",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "path",
                  "value": "<string>",
                  "description": "Restrict the search to Assets in the specified folder and all child folders. If no path is given, the app should search globally"
                },
                {
                  "disabled": false,
                  "key": "term",
                  "value": "<string>",
                  "description": "(Required) Search query term or phrase."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "(pagination) The offset of the first result to return. Default is 0."
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "<integer>",
                  "description": "(pagination) The Number of items to return per page. Default is 10."
                }
              ],
              "variable": []
            },
