          "name": "OAuth2 Authorization",
          "request": {
            "name": "OAuth2 Authorization",
            "description": {
              "content": "<p> <a href='https://tools.ietf.org/html/rfc6749#section-3.1'>OAuth2 Authorize</a> endpoint. Will need to be configured in Knak. </p>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth2",
                "authorize"
              ],
              "host": [
                "{{oauth2-authorize-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
